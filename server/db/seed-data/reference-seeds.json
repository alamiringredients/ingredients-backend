              },
    {
      "key": "credentials",
      "label": "Group credentials",
      "enabled": true,
      "texts": [
        {
          "id": "text-a4cccd3365",
          "label": "Where we stand",
          "source": "Where we stand"
        },
        {
          "id": "text-49c6ebec9e",
          "label": "Two different questions,",
          "source": "Two different questions,"
        },
        {
          "id": "text-27d7628012",
          "label": "two honest answers.",
          "source": "two honest answers."
        },
        {
          "id": "text-2c5ffecc3c",
          "label": "Procurement teams ask two things when they evaluate a new supplier: w...",
          "source": "Procurement teams ask two things when they evaluate a new supplier: what does the organisation behind this plant already prove it can do, and what has this specific facility been certified for. Those are separate questions and we keep them separate. Al Amir Group has held food safety, quality and environmental certification for years across its trading and processing operations. Alamir Ingredients is a new facility running its own certification programme from the ground up, and until an audit is passed we say “planned”."
        },
        {
          "id": "text-2b4ac0b6f5",
          "label": "Certificates for every item above are available as a single archive i...",
          "source": "Certificates for every item above are available as a single archive in the"
        },
        {
          "id": "text-a3b3ce97af",
          "label": "downloads library",
          "source": "downloads library"
        }
      ],
      "assets": [],
      "links": []
              },
    {
      "key": "roadmap",
      "label": "Facility roadmap",
      "enabled": true,
      "texts": [
        {
          "id": "text-ad6066a350",
          "label": "Facility roadmap",
          "source": "Facility roadmap"
        },
        {
          "id": "text-216d390366",
          "label": "The Sadat City certification",
          "source": "The Sadat City certification"
        },
        {
          "id": "text-8154242d42",
          "label": "programme.",
          "source": "programme."
        },
        {
          "id": "text-05bd82085b",
          "label": "Nine certifications scoped to the Sadat City site and its own product...",
          "source": "Nine certifications scoped to the Sadat City site and its own product lines — not carried across from the Group."
        },
        {
          "id": "text-dccf5df676",
          "label": "We publish the status rather than the aspiration, and this page is up...",
          "source": "We publish the status rather than the aspiration, and this page is updated as each audit closes."
        }
      ],
      "assets": [],
      "links": []
              },
    {
      "key": "technology",
      "label": "Technology",
      "enabled": true,
      "texts": [
        {
          "id": "text-d018b082e8",
          "label": "Technology",
          "source": "Technology"
        },
        {
          "id": "text-fc26618b48",
          "label": "CFT processing, aseptic",
          "source": "CFT processing, aseptic"
        },
        {
          "id": "text-23f5e390ca",
          "label": "from end to end.",
          "source": "from end to end."
        },
        {
          "id": "text-fe96645361",
          "label": "The line is built on CFT architecture from Italy — the same process t...",
          "source": "The line is built on CFT architecture from Italy — the same process technology used by the tomato processors that supply Europe’s largest brands. Hot break and cold break are run as distinct process paths rather than as settings on a single line, which is what lets us hold viscosity and colour to a specification instead of to a season."
        },
        {
          "id": "text-f1e6773d6b",
          "label": "Tomatoes on the sorting conveyor at intake, under wash spray",
          "source": "Tomatoes on the sorting conveyor at intake, under wash spray"
        },
        {
          "id": "text-1c5a2616b9",
          "label": "Reception and sorting",
          "source": "Reception and sorting"
        },
        {
          "id": "text-64865cf93c",
          "label": "Optical sorting and washing on intake, with every lot traced to the f...",
          "source": "Optical sorting and washing on intake, with every lot traced to the farm block it came from before it enters the line."
        },
        {
          "id": "text-29da5a792c",
          "label": "Multi effect vacuum evaporator columns on the CFT line",
          "source": "Multi-effect vacuum evaporator columns on the CFT line"
        },
        {
          "id": "text-3fe997b691",
          "label": "Evaporation",
          "source": "Evaporation"
        },
        {
          "id": "text-93d99b15f0",
          "label": "Multi effect evaporation under vacuum, holding product temperature lo...",
          "source": "Multi-effect evaporation under vacuum, holding product temperature low enough to protect colour and flavour while concentrating to target Brix."
        },
        {
          "id": "text-b1f6da4d65",
          "label": "Tomato paste filling into a sterile liner inside a steel drum",
          "source": "Tomato paste filling into a sterile liner inside a steel drum"
        },
        {
          "id": "text-15fc9776f9",
          "label": "Aseptic filling",
          "source": "Aseptic filling"
        },
        {
          "id": "text-65d9329a46",
          "label": "Sterile filling into aseptic bags in steel drums or bins, giving ambi...",
          "source": "Sterile filling into aseptic bags in steel drums or bins, giving ambient shelf life without a cold chain and without preservatives."
        }
      ],
