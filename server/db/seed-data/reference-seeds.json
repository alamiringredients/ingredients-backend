      "texts": [
        {
          "id": "text-d7f58eefad",
          "label": "Quality & capability",
          "source": "Quality & capability"
        },
        {
          "id": "text-ffc2dc07e4",
          "label": "Specification led,",
          "source": "Specification-led,"
        },
        {
          "id": "text-c03a68cab2",
          "label": "audit ready.",
          "source": "audit-ready."
        },
        {
          "id": "text-a01c49b8e4",
          "label": "A new facility does not inherit certificates. This page sets out exac...",
          "source": "A new facility does not inherit certificates. This page sets out exactly what Al Amir Group holds today, what the Sadat City facility is certifying for, and the processing and sourcing controls that sit behind every batch we ship."
        }
      ],
      "assets": [
        {
          "id": "asset-f4f7174081",
