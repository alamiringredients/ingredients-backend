# Copy to .env and fill in your local credentials.
# Generate APP_KEY with: npx holo key:generate
APP_NAME="Alamir Ingredients"
APP_KEY=
APP_URL=http://localhost:8000
APP_ENV=development
APP_DEBUG=true

# Must match the frontend origin, including its port.
FRONTEND_URL=http://localhost:3000
# Frontend host and port without the URL scheme.
FRONTEND_DOMAIN=localhost:3000

# MySQL is configured in config/database.ts. Create an empty database before migrating.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=alamir_relational

# Backend session cookie. Leave SESSION_DOMAIN unset for a host-only cookie.
# Use SESSION_SECURE=true with HTTPS in production.
SESSION_DRIVER=file
SESSION_CONNECTION=main
SESSION_COOKIE=alamir_session
SESSION_PATH=/
# SESSION_DOMAIN=example.com
SESSION_SECURE=false
SESSION_SAME_SITE=lax
# Session lifetimes are in minutes.
SESSION_IDLE_TIMEOUT=120
SESSION_LIFETIME=120
SESSION_REMEMBER_ME_LIFETIME=43200

# The file cache driver is configured in config/cache.ts.
CACHE_PREFIX=alamir_relational

STORAGE_DEFAULT_DISK=public
STORAGE_ROUTE_PREFIX=/storage

# Local mail preview; use smtp and configure credentials when sending real mail.
MAIL_MAILER=preview
MAIL_FROM_ADDRESS=careers@alamir.test
MAIL_FROM_NAME="Alamir Ingredients"
MAIL_LOG_BODIES=false
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: set true only when your ingress replaces X-Forwarded-For with one verified IP.
# Without a trusted ingress, public forms are limited by normalized email address.
HOLO_SECURITY_TRUST_PROXY=false
