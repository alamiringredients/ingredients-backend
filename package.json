{
  "name": "alamir-backend",
  "private": true,
  "type": "module",
  "packageManager": "npm@latest",
  "scripts": {
    "prepare": "holo key:generate && holo prepare && (cp -r .next/standalone/.next/node_modules/@holo-js/* .next/standalone/node_modules/@holo-js/ 2>/dev/null || true) && (cp -r config .next/standalone/config 2>/dev/null || true) && (cp -r lib .next/standalone/lib 2>/dev/null || true) && (for dep in mysql2 aws-ssl-profiles generate-function iconv-lite long lru.min named-placeholders sql-escaper is-property safer-buffer; do cp -rL node_modules/$dep .next/standalone/node_modules/$dep 2>/dev/null || true; done)",
    "dev": "PORT=8000 holo dev",
    "prebuild": "npm run translations:generate",
    "build": "echo skip",
    "build:holo": "holo build",
    "start": "holo start --port 8000",
    "lint": "eslint app components config i18n lib server tests proxy.ts next.config.ts --no-warn-ignored --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:catalog": "node scripts/test-catalog.mjs",
    "catalog:heroes": "node scripts/generate-category-hero-assets.mjs",
    "translations:generate": "node scripts/generate-content-translations.mjs",
    "config:cache": "holo config:cache",
    "config:clear": "holo config:clear",
    "db:seed": "holo seed --only database --quietly && holo cache:clear",
    "db:migrate": "holo migrate",
    "test:certifications": "node scripts/test-catalog.mjs tests/certifications.test.tsx",
    "test:quality-page": "node scripts/test-catalog.mjs tests/quality-page-seeder.test.ts",
    "test:database": "node scripts/test-catalog.mjs tests/relational-database.integration.test.ts && node scripts/test-catalog.mjs tests/translation-seeder.integration.test.ts",
    "test:login": "node --test tests/login.browser.test.mjs",
    "test:public-cache": "node scripts/test-catalog.mjs tests/content-page-cache.integration.test.ts",
    "test:crud": "node scripts/test-catalog.mjs tests/crud-pagination.integration.test.ts && node scripts/test-catalog.mjs tests/crud-list.test.tsx",
    "test:security": "node --test tests/security.test.mjs tests/rate-limit-security.test.mjs tests/change-password.test.mjs && node scripts/test-catalog.mjs tests/upload-security.test.ts",
    "test:public-api": "node scripts/test-catalog.mjs tests/public-route.test.ts"
  },
  "dependencies": {
    "@holo-js/adapter-next": "0.3.15",
    "@holo-js/auth": "0.3.15",
    "@holo-js/authorization": "0.3.15",
    "@holo-js/cache": "0.3.15",
    "@holo-js/cache-redis": "^0.3.15",
    "@holo-js/cli": "0.3.15",
    "@holo-js/config": "0.3.15",
    "@holo-js/core": "0.3.15",
    "@holo-js/db": "0.3.15",
    "@holo-js/db-mysql": "0.3.15",
    "@holo-js/forms": "0.3.15",
    "@holo-js/kernel": "0.3.15",
    "@holo-js/mail": "0.3.15",
    "@holo-js/media": "0.3.15",
    "@holo-js/notifications": "0.3.15",
    "@holo-js/security": "0.3.15",
    "@holo-js/session": "0.3.15",
    "@holo-js/storage": "0.3.15",
    "@holo-js/storage-s3": "^0.3.15",
    "@holo-js/validation": "0.3.15",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "esbuild": "^0.28.2",
    "file-type": "^21.3.0",
    "ioredis": "^5.4.2",
    "next": "^16.2.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "saxes": "^6.0.0",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.17.0",
    "fflate": "^0.8.3",
    "globals": "^15.14.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.30.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "@holo-js/media": {
      "sharp": "^0.35.4"
    },
    "@holo-js/mail": {
      "nodemailer": "^10.0.9"
    }
  }
}
